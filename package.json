{
  "name": "pamela-os",
  "version": "1.0.0",
  "private": true,
  "description": "Pamela OS — the A Cup of Compassion operating system. One installable PWA for CRM, meetings, receptionist, funnels, campaigns, studios and the Hermes operator layer.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-env.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx worker/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "lucide-react": "1.61.0",
    "next": "15.5.27",
    "postgres": "3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.27",
    "playwright-core": "^1.56.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
