# Only needed for the single-VPS deployment (instead of Vercel).
[Unit]
Description=Pamela OS web app
After=network-online.target

[Service]
Type=simple
User=pamela
WorkingDirectory=/opt/pamela-os
EnvironmentFile=/opt/pamela-os/.env
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
