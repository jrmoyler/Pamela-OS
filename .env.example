# ── Core ─────────────────────────────────────────────────────────────
# Public URL of the app (used for signed media links, payment links, webhooks)
APP_URL=https://os.acupofcompassion.com
# Long random strings. AUTH_SECRET signs sessions; ENCRYPTION_KEY encrypts stored API keys.
AUTH_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-another-long-random-string
# Bearer token for /api/cron/tick (Vercel cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=change-me

# ── Database & storage ──────────────────────────────────────────────
# Postgres you control (Supabase recommended). Leave unset for local embedded Postgres in ./.data
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Supabase Storage (leave unset to store files on the server disk in ./storage)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pamela-os
# Set to 0 on the web app when the VPS worker is running
INLINE_JOBS=1

# ── Everything below can ALSO be entered in-app (Settings → Connections) ──
# Operator layer
HERMES_BASE_URL=https://rj.acupofcompassion.com/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
META_API_BASE_URL=https://api.llama.com/compat/v1
META_API_KEY=
META_MODEL=muse-spark
# Her models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
WHISPER_URL=
# Phone & SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+13239432287
# Email
RESEND_API_KEY=
# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Social
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
# Studios
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=
SUNO_API_BASE_URL=
SUNO_API_KEY=
ELEVENLABS_API_KEY=
CHATTERBOX_URL=
# File sources (Library → Pull from). Refresh tokens are long-lived; see README "Command Center".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_INBOX_FOLDER_ID=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_INBOX_PATH=
WORKER_TOKEN=
